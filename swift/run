#!/bin/bash
# Run odca or odca-select straight out of a fresh clone: builds the release
# configuration (the debug build is choppy) on first use and whenever the
# sources changed, then runs the binary with the remaining arguments. File
# paths are relative to where you run this from, not to this script.
#
#   swift/run odca show.play [more files] [--shuffle] [--fullscreen]
#   swift/run odca-select my-pairs.odca
#   swift/run odca-evolve my-pairs.odca --cells 600 --time 300
#   swift/run test               # the test suite
set -e
dir="$(cd "$(dirname "$0")" && pwd)"
prog="$1"
case "$prog" in
  odca|odca-select|odca-evolve) shift ;;
  test) exec swift test --package-path "$dir" ;;
  *) echo "usage: swift/run odca|odca-select|odca-evolve|test [arguments]"; exit 2 ;;
esac
# Quiet when there is nothing to compile; compiler output and errors still show.
swift build --package-path "$dir" -c release --product "$prog" 2>&1 \
  | grep -v "^\[\|^Building for\|^Build of product\|^Build complete" >&2 || true
exec "$dir/.build/release/$prog" "$@"
