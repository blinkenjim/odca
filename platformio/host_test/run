#!/bin/bash
# Build and run the engine's host-side conformance check: regenerates
# build/vectors_data.h from ../../conformance/vectors.json, compiles
# ../lib/odca_engine straight with cc (no PlatformIO, no board), and runs
# it. Exits nonzero if anything failed, per TESTS.md's runner contract.
set -e
dir="$(cd "$(dirname "$0")" && pwd)"
mkdir -p "$dir/build"
python3 "$dir/gen_vectors.py" "$dir/build/vectors_data.h"
# An explicit sysroot from Xcode itself, rather than relying on cc's bare
# default: on macOS this is the standard way to ask, and it has saved a
# broken default SDK (mid-OS-update, `cc` refusing to link anything at
# all) at least once already.
cc -isysroot "$(xcrun --sdk macosx --show-sdk-path)" \
   -std=c11 -Wall -Wextra -Werror \
   -I "$dir/../lib/odca_engine" -I "$dir/build" \
   -o "$dir/build/test_engine" \
   "$dir/../lib/odca_engine/odca_engine.c" "$dir/test_engine.c"
exec "$dir/build/test_engine"
